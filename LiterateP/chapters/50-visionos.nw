import SwiftUI

struct OrnamentStyle: ViewModifier {
    func body(content: Content) -> some View {
        content
            .toggleStyle(.button)
            .buttonStyle(.borderless)
            .labelStyle(.iconOnly)
            .padding(12)
            .glassBackgroundEffect(in: .rect(cornerRadius: 50))
    }
