\section{The application delegate}

The delegate exists to disconnect a classic session when the application terminates. It keeps the
CloudXRKit session only; a foveated session belongs to the system and ends with the process.

<<CloudXRViewer/Common/AppDelegate.swift>>=
<<NVIDIA license header>>

import Foundation
import SwiftUI
import os.log
import CloudXRKit

class AppDelegate: NSObject, UIApplicationDelegate {
    var app: UIApplication?
    var session: Session?

    private static let logger = Logger(
        subsystem: Bundle(for: AppDelegate.self).bundleIdentifier!,
        category: String(describing: AppDelegate.self)
    )

    func application(
        _ application: UIApplication,
        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey : Any]? = nil
    ) -> Bool {
        app = application
        return true
    }

    // Currently never called for visionOS
    func applicationWillTerminate(_ application: UIApplication) {
        AppDelegate.logger.info("Disconnecting before app terminates")
        session?.disconnect()
    }
}
@nonl
