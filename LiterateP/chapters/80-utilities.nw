The form's computed properties. The backend binding writes
through to the model. The status line shows the active session's own description, followed by the
last foveated connection error if there is one. The button label and its enabled state follow the
neutral status.

<<CloudXRViewer/Common/SessionConfigView+extensions.swift>>=
extension SessionConfigView {

    var backendSelection: Binding<StreamingBackend> {
        Binding(
            get: { appModel.backend },
            set: { appModel.backend = $0 }
        )
    }

    var stateDescription: String {
        let description = appModel.activeSession?.statusDescription ?? ""
        if appModel.backend == .foveated, let error = appModel.foveatedConnectError {
            return "\(description): \(error)"
        }
        return description
    }

    var buttonLabel: String {
        switch appModel.status {
        case .connected: "Disconnect"
        case .paused, .pausing: "Resume"
        default: "Connect"
        }
    }

    var usingGuestMode: Bool {
        authMethod == .guest && zone != .ipAddress
    }

    var connectButtonDisabled: Bool {
        switch appModel.status {
        case .connecting, .disconnecting, .resuming, .pausing:
            true
        default:
            false
        }
    }
}
