\section{The streaming view}

The stream is drawn by [[FoveatedStreamingView]] for the StreamingSession backend and by a
RealityKit view with the CloudXRKit session component for the classic one. The HUD and its button
exist only for the classic backend.

<<CloudXRViewer/iOS/StreamingView+iOS.swift>>=
<<NVIDIA license header>>

import SwiftUI
import RealityKit
import CloudXRKit
import StreamingSession
import ARKit
import Foundation

struct BasicStreamingView : View {
    enum Section {
        case none
        case launch
        case actions
    }

    @Environment(AppModel.self) var appModel

    @Environment(\.colorScheme) var colorScheme

    @State private var sessionEntity = Entity()
    @State var showHUD = false

    @State var selectedSection: Section = .none

    @Binding var application: Application

    @State var currentChannelSelection: ViewerChannelID?
    @State var currentChannel: (any ViewerChannel)?

    var body: some View {
        ZStack(alignment: .bottom) {
            if appModel.backend == .foveated {
                FoveatedStreamingView(session: appModel.foveatedSession)
                    .edgesIgnoringSafeArea(.all)
            } else {
                classicStreamView
            }

            if showHUD && appModel.backend == .classic {
                hudView
            }

            switch selectedSection {
            case .launch:
                SessionConfigView(application: $application) {}
            case .none:
                EmptyView()
            case .actions:
                ServerActionsView(
                    currentChannelSelection: $currentChannelSelection,
                    currentChannel: $currentChannel
                )
                    .frame(minHeight: 160, maxHeight: 690)
            }

            // Show the overylay UI only when connected.
            if appModel.status == .connected {
                VStack {
                    Spacer()
                    // Button to enable/disable HUD.
                    HStack {
                        actionsButton
                        Spacer()
                        configButton
                        if appModel.backend == .classic {
                            Spacer()
                            hudButton
                        }
                    }
                }
                .padding([.leading, .trailing, .bottom], 16)
            } else {
                // Show black/white background instead of passthrough when not connected.
                (colorScheme == .dark ? Color.black : Color.white).ignoresSafeArea()
                // Show the SessionConfigView for user to reconnect.
                SessionConfigView(application: $application) {}
            }
        }
    }

@
The classic stream view uses ARKit's spatial tracking
camera, so the stream is composited over the camera image.

<<CloudXRViewer/iOS/StreamingView+iOS.swift>>=
    /// CloudXRKit renders through a RealityKit entity carrying the session component.
    private var classicStreamView: some View {
        RealityView { content in
            sessionEntity.name = "Session"
            // The camera that displays virtual RealityKit content and camera passthrough, with tracking capabilities.
            content.camera = .spatialTracking
            if let session = appModel.session {
                sessionEntity.components[CloudXRSessionComponent.self] = .init(session: session)
            }

            content.add(sessionEntity)
        }
        .edgesIgnoringSafeArea(.all)
    }
}

